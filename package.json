{
  "name": "@tree-sitter-grammars/tree-sitter-tcl",
  "version": "1.1.0",
  "description": "Tcl grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "tree-sitter",
    "parser",
    "lexer",
    "tcl",
    "incremental",
    "parsing"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**/*.c",
    "src/**/*.h",
    "src/**/*.json",
    "tree-sitter.json",
    "*.wasm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tree-sitter-grammars/tree-sitter-tcl.git"
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "lint": "eslint .",
    "prebuildify": "prebuildify --napi --strip"
  },
  "author": {
    "email": "lewis6991@gmail.com",
    "name": "Lewis Russell"
  },
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.27.2",
    "eslint-config-treesitter": "^1.0.2",
    "tree-sitter": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
